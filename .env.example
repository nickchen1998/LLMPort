# 複製成 .env 後修改。.env 不進版控。

# ─── 應用程式 ───
APP_HOST=127.0.0.1            # 只綁本機，外網一律經 Cloudflare Tunnel
APP_PORT=8080
APP_RELOAD=false
# SECRET_KEY=                 # 留空時自動產生並保存在 tmp_files/.secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── PostgreSQL（docker compose 的 postgres，或 Homebrew）───
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=llmport
POSTGRES_USER=llmport
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql+psycopg2://llmport:change-me@127.0.0.1:5433/llmport

# ─── Redis（限流、本月用量計數）───
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0

# ─── 模型 ───
MODEL_DIR=./model_files        # 模型下載的位置，Mac mini 上可以改成 ~/LLMPort/models
WORKER_PORT_BASE=9100          # worker 的 port = 這個數字 + 模型 id
WORKER_LOAD_TIMEOUT=900        # 載入逾時秒數
# HF_TOKEN=                    # 下載需要授權的模型（例如 Gemma、Llama）時才需要

# 沒有模型檔時改用假 worker（模擬回覆、模擬記憶體），開發與展示用；Mac mini 正式環境設 false
FAKE_WORKERS=true
FAKE_TPS=40                    # 假 worker 每秒輸出幾個 token
FAKE_LOAD_SECONDS=2            # 假 worker 載入要幾秒

# ─── 對外網域（Cloudflare Tunnel）───
# 設定後，從 API 網域進來的請求只能用 /v1，其他路徑一律 404
# API_HOST=api.example.com
# CONSOLE_HOST=console.example.com
# CLOUDFLARED_METRICS_URL=http://127.0.0.1:20241

# ─── 建立第一位 Superuser（create_superuser.py 讀取）───
# SUPERUSER_EMAIL=owner@example.com
# SUPERUSER_NAME=站長
# SUPERUSER_PASSWORD=
